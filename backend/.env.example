# Copie para backend/.env e preencha. NUNCA commite o .env real.

# Neon (Postgres) — formato: postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL: a POOLED (host com -pooler) — usada pela aplicação (ver 7.6).
DATABASE_URL=
# DATABASE_URL_DIRECT: a DIRECT (host SEM -pooler) — usada só pelas migrations.
# Em dev pode deixar vazio; run.ts cai na DATABASE_URL.
DATABASE_URL_DIRECT=

# HTTP
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Assina o cookie de sessão do dono.
# Dev pode usar este. Em produção é OBRIGATÓRIO e o processo não sobe sem ele.
# Gere o de produção com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=dev-local-somente-nao-use-em-producao

# --- Cloudflare R2 (Fase 5: upload de imagem) ---
# Sem estas vars o app sobe normal; só a rota de upload e o `npm run limpar-r2` falham (503).
# Endpoint S3 montado da env: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com (região auto).
# Token Object Read & Write ESCOPADO ao bucket mostruario-midia — nunca token de conta/Admin (7.1).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mostruario-midia
R2_PUBLIC_BASE=https://midia.SEU-DOMINIO

# Backup incremental do R2 (script backend/scripts/backup-r2.mjs; agendado no GitHub Actions).
# Copia SÓ-ADIÇÃO de R2_BUCKET para R2_BACKUP_BUCKET (nunca apaga do backup).
# Usa DOIS tokens (os do R2 sao escopados por bucket): SRC le a origem, DST escreve no
# backup. Pode ser o MESMO token nos dois lados se ele tiver Object Read & Write nos dois
# buckets (ou em todos). Configurados como secrets no GitHub Actions.
R2_BACKUP_BUCKET=sistema-backup-mostruario1
R2_SRC_ACCESS_KEY_ID=
R2_SRC_SECRET_ACCESS_KEY=
R2_DST_ACCESS_KEY_ID=
R2_DST_SECRET_ACCESS_KEY=

# --- Link público de compartilhamento (/r/<token>) ---
# LINK_PUBLICO_DIAS: por quantos DIAS o link fica no ar até expirar. 0 = nunca expira.
# Vale para os links gerados DEPOIS de mudar (a validade fica gravada no token). Padrão: 30.
LINK_PUBLICO_DIAS=30
# LINK_PUBLICO_SEGREDO: segredo que ASSINA os links. Trocar aqui REVOGA todos os links
# já enviados (passam a dar "link inválido ou expirado"). Vazio = reusa o COOKIE_SECRET.
LINK_PUBLICO_SEGREDO=
